{
  "name": "@draft-loop/ui",
  "version": "0.8.0-alpha.5",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./src/app.tsx",
      "import": "./src/app.tsx"
    },
    "./host-panels": {
      "types": "./src/host-panels.tsx",
      "import": "./src/host-panels.tsx"
    },
    "./job-requirements-extraction": {
      "types": "./src/job-requirements-extraction.tsx",
      "import": "./src/job-requirements-extraction.tsx"
    },
    "./new-application-form": {
      "types": "./src/new-application-form.tsx",
      "import": "./src/new-application-form.tsx"
    },
    "./review": {
      "types": "./src/review.tsx",
      "import": "./src/review.tsx"
    },
    "./start-checklist": {
      "types": "./src/start-checklist.tsx",
      "import": "./src/start-checklist.tsx"
    },
    "./styles.css": "./src/styles.css",
    "./workspace-setup": {
      "types": "./src/workspace-setup.tsx",
      "import": "./src/workspace-setup.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@draft-loop/application": "workspace:*",
    "@draft-loop/artifacts": "workspace:*",
    "@draft-loop/domain": "workspace:*",
    "@draft-loop/providers": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@draft-loop/rendering": "workspace:*",
    "@draft-loop/storage": "workspace:*"
  }
}
