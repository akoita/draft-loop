      "definition": "Merges periods, shifts dates, puts work under the wrong role, or hides a recorded gap."
    },
    {
      "id": "attribution-inflation",
      "definition": "Turns team, supervised or shared work into sole ownership or leadership."
    },
    {
      "id": "scope-stretch",
      "definition": "Turns attendance, a booked course, occasional duty or partial evidence into a held credential or a regular role."
    },
    {
      "id": "must-cover-omission",
      "definition": "Leaves out a mustCover fact the job needs (other than a whole role, which is role-omission)."
    },
    {
      "id": "requirement-overclaim",
      "definition": "Presents an unsupported requirement as met."
    },
    {
      "id": "no-draft",
      "definition": "Produces no admitted draft (validator rejection, budget stop, error)."
    },
    {
      "id": "role-omission",
      "definition": "Leaves out a whole dated employment role the source records. Added: seen in 19 rounds."
    },
    {
      "id": "placeholder-left",
      "definition": "Leaves template placeholders such as [Your name], [Email] or [Phone] in the header. Added: seen in 37 rounds."
    }
