{
  "realm": "draft-loop-local",
  "enabled": true,
  "displayName": "DraftLoop local stack",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "draft-loop-web",
      "name": "DraftLoop web screen",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://127.0.0.1:58082/*", "http://localhost:5173/*"],
      "webOrigins": ["http://127.0.0.1:58082", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:58082/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "draft-loop-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "draft-loop-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "draft-loop-local-smoke",
      "name": "Local stack smoke test only",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "draft-loop-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "draft-loop-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@org-a.example",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "local-stack-password-a", "temporary": false }]
    },
    {
      "username": "ben",
      "email": "ben@org-b.example",
      "emailVerified": true,
      "firstName": "Ben",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "local-stack-password-b", "temporary": false }]
    },
    {
      "username": "una",
      "email": "una@org-a.example",
      "emailVerified": false,
      "firstName": "Una",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "local-stack-password-u", "temporary": false }]
    }
  ]
}
