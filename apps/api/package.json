{
  "name": "@draft-loop/api",
  "version": "0.8.0-alpha.4",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "openapi.json"
  ],
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "openapi": "tsx src/write-openapi.ts"
  },
  "dependencies": {
    "@draft-loop/application": "workspace:*",
    "@draft-loop/orchestrator": "workspace:*",
    "@draft-loop/schemas": "workspace:*",
    "@draft-loop/storage": "workspace:*",
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.9.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "openapi-types": "12.1.3"
  }
}
