    "@draft-loop/review-state": "workspace:*",
    "@draft-loop/run-queue": "workspace:*",
    "@draft-loop/schemas": "workspace:*",
    "@draft-loop/storage": "workspace:*",
    "@draft-loop/storage-gcs": "workspace:*",
    "@draft-loop/storage-postgres": "workspace:*",
    "@draft-loop/ui": "workspace:*",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.0",
    "@google-cloud/storage": "8.3.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
